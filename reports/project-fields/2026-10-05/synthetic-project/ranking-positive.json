    "sql": "WITH history AS (\n  SELECT b.mktcode AS mktcode,b.tgtcode AS tgtcode,b.bizdate AS bizdate,\n    b.closePrice AS `v1`\n  FROM dsl_project_fixture_6b2c50df4a36.v_hsj_stock_hq_basic b\n  WHERE b.bizdate <= ?\n),\nhistory_ranked AS (\n  SELECT history.*, ROW_NUMBER() OVER (PARTITION BY mktcode,tgtcode ORDER BY bizdate DESC) AS observation_rank\n  FROM history\n),\nobserved_tail AS (\n  SELECT * FROM history_ranked WHERE observation_rank<=1\n),\nfeatures AS (\n  SELECT observed_tail.*,\n    `v1` AS `f1`\n  FROM observed_tail\n),\ncurrent_rows AS (\n  SELECT * FROM features WHERE bizdate = ?\n),\nprefiltered AS (\n  SELECT * FROM current_rows WHERE (`f1` > ?)\n),\nrank_input AS (\n  SELECT * FROM prefiltered WHERE `v1` IS NOT NULL\n),\nranked AS (\n  SELECT rank_input.*,\n    ROW_NUMBER() OVER (ORDER BY `v1` DESC,mktcode,tgtcode) AS `r1`\n  FROM rank_input\n)\nSELECT mktcode,tgtcode\nFROM ranked\nWHERE (`r1` <= ?)\nORDER BY `r1`,mktcode,tgtcode\nLIMIT 1;",
    "bindings": [
