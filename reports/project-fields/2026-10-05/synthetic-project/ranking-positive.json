    ],
    "ordered": true,
    "coveragePlan": {
      "sql": "WITH history AS (\n  SELECT b.mktcode AS mktcode,b.tgtcode AS tgtcode,b.bizdate AS bizdate,\n    b.closePrice AS `v1`\n  FROM dsl_project_fixture_6b2c50df4a36.v_hsj_stock_hq_basic b\n  WHERE b.bizdate <= ?\n),\nhistory_ranked AS (\n  SELECT history.*, ROW_NUMBER() OVER (PARTITION BY mktcode,tgtcode ORDER BY bizdate DESC) AS observation_rank\n  FROM history\n),\nobserved_tail AS (\n  SELECT * FROM history_ranked WHERE observation_rank<=1\n),\nfeatures AS (\n  SELECT observed_tail.*,\n    `v1` AS `f1`\n  FROM observed_tail\n),\ncurrent_rows AS (\n  SELECT * FROM features WHERE bizdate = ?\n)\nSELECT COUNT(*),COALESCE(SUM(0),0),COALESCE(SUM(CASE WHEN cov.`f1` IS NULL THEN 1 ELSE 0 END),0),COALESCE(SUM(CASE WHEN cov.`v1` IS NULL THEN 1 ELSE 0 END),0) FROM current_rows cov;",
      "samplesSql": "WITH history AS (\n  SELECT b.mktcode AS mktcode,b.tgtcode AS tgtcode,b.bizdate AS bizdate,\n    b.closePrice AS `v1`\n  FROM dsl_project_fixture_6b2c50df4a36.v_hsj_stock_hq_basic b\n  WHERE b.bizdate <= ?\n),\nhistory_ranked AS (\n  SELECT history.*, ROW_NUMBER() OVER (PARTITION BY mktcode,tgtcode ORDER BY bizdate DESC) AS observation_rank\n  FROM history\n),\nobserved_tail AS (\n  SELECT * FROM history_ranked WHERE observation_rank<=1\n),\nfeatures AS (\n  SELECT observed_tail.*,\n    `v1` AS `f1`\n  FROM observed_tail\n),\ncurrent_rows AS (\n  SELECT * FROM features WHERE bizdate = ?\n)\nSELECT cov.mktcode,cov.tgtcode,0,CASE WHEN cov.`f1` IS NULL THEN 1 ELSE 0 END,CASE WHEN cov.`v1` IS NULL THEN 1 ELSE 0 END FROM current_rows cov WHERE cov.`f1` IS NULL OR cov.`v1` IS NULL ORDER BY cov.mktcode,cov.tgtcode LIMIT 20;",
