      "extensionRequired": true,
      "combinedSql": "WITH base AS (\n  SELECT b.mktcode AS mktcode, b.tgtcode AS tgtcode, b.bizdate AS bizdate,\n    b.closePrice AS `m1`,\n    NULLIF(e.ZJLXMainNetTur,-999999) AS `m2`\n  FROM dsl_project_fixture_6b2c50df4a36.v_hsj_stock_hq_basic b\n  LEFT JOIN dsl_project_fixture_6b2c50df4a36.v_hsj_stock_hq_ext e ON e.mktcode=b.mktcode AND e.tgtcode=b.tgtcode AND e.bizdate=b.bizdate\n  WHERE DATE_FORMAT(b.bizdate,'%Y-%m-%d') = ?\n),\ncoverage_flags AS (\n  SELECT cov.mktcode,cov.tgtcode,CASE WHEN cx.tgtcode IS NULL THEN 1 ELSE 0 END AS ext_missing,CASE WHEN cov.`m1` IS NULL THEN 1 ELSE 0 END AS u0,CASE WHEN cov.`m2` IS NULL THEN 1 ELSE 0 END AS u1 FROM base cov LEFT JOIN dsl_project_fixture_6b2c50df4a36.v_hsj_stock_hq_ext cx ON cx.mktcode=cov.mktcode AND cx.tgtcode=cov.tgtcode AND cx.bizdate=?\n),\ncoverage_totals AS (\n  SELECT coverage_flags.*,COUNT(*) OVER () AS observed,SUM(ext_missing) OVER () AS missing,SUM(u0) OVER () AS n0,SUM(u1) OVER () AS n1,ROW_NUMBER() OVER (ORDER BY CASE WHEN ext_missing=1 OR u0=1 OR u1=1 THEN 0 ELSE 1 END,mktcode,tgtcode) AS sample_rank\n  FROM coverage_flags\n)\nSELECT COALESCE(d.observed,0),COALESCE(d.missing,0),COALESCE(d.n0,0),COALESCE(d.n1,0),d.mktcode,d.tgtcode,d.ext_missing,d.u0,d.u1\nFROM (SELECT 1 AS seed) s LEFT JOIN (SELECT * FROM coverage_totals WHERE sample_rank<=20) d ON TRUE\nORDER BY d.sample_rank;"
