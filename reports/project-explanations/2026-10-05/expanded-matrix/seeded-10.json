    "windowContracts": [],
    "sql": "WITH base AS (\n  SELECT b.mktcode AS mktcode, b.tgtcode AS tgtcode, b.bizdate AS bizdate,\n    b.closePrice AS `m1`,\n    b.volume AS `m2`,\n    b.openPrice AS `m3`\n  FROM newzl.v_hsj_stock_hq_basic b\n  WHERE DATE_FORMAT(b.bizdate,'%Y-%m-%d') = ?\n    AND b.mktcode = 103\n)\nSELECT mktcode, tgtcode\nFROM base\nWHERE ((`m1` <= ?) OR ((`m2` > ?) OR (`m3` <= ?)))\nORDER BY mktcode, tgtcode\nLIMIT 10000;",
    "bindings": [
      "2020-02-03",
      5,
      10000000,
      1
    ],
    "ordered": false,
    "coveragePlan": {
      "sql": "WITH base AS (\n  SELECT b.mktcode AS mktcode, b.tgtcode AS tgtcode, b.bizdate AS bizdate,\n    b.closePrice AS `m1`,\n    b.volume AS `m2`,\n    b.openPrice AS `m3`\n  FROM newzl.v_hsj_stock_hq_basic b\n  WHERE DATE_FORMAT(b.bizdate,'%Y-%m-%d') = ?\n    AND b.mktcode = 103\n)\nSELECT COUNT(*),COALESCE(SUM(0),0),COALESCE(SUM(CASE WHEN cov.`m1` IS NULL THEN 1 ELSE 0 END),0),COALESCE(SUM(CASE WHEN cov.`m2` IS NULL THEN 1 ELSE 0 END),0),COALESCE(SUM(CASE WHEN cov.`m3` IS NULL THEN 1 ELSE 0 END),0) FROM base cov;",
      "samplesSql": "WITH base AS (\n  SELECT b.mktcode AS mktcode, b.tgtcode AS tgtcode, b.bizdate AS bizdate,\n    b.closePrice AS `m1`,\n    b.volume AS `m2`,\n    b.openPrice AS `m3`\n  FROM newzl.v_hsj_stock_hq_basic b\n  WHERE DATE_FORMAT(b.bizdate,'%Y-%m-%d') = ?\n    AND b.mktcode = 103\n)\nSELECT cov.mktcode,cov.tgtcode,0,CASE WHEN cov.`m1` IS NULL THEN 1 ELSE 0 END,CASE WHEN cov.`m2` IS NULL THEN 1 ELSE 0 END,CASE WHEN cov.`m3` IS NULL THEN 1 ELSE 0 END FROM base cov WHERE cov.`m1` IS NULL OR cov.`m2` IS NULL OR cov.`m3` IS NULL ORDER BY cov.mktcode,cov.tgtcode LIMIT 20;",
