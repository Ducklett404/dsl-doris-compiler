    "sql": "WITH history AS (\n  SELECT b.mktcode AS mktcode,b.tgtcode AS tgtcode,b.bizdate AS bizdate,\n    NULLIF(e.ZJLXMainNetTur,-999999) AS `v1`,\n    b.closePrice AS `v2`\n  FROM newzl.v_hsj_stock_hq_basic b\n  LEFT JOIN newzl.v_hsj_stock_hq_ext e ON e.mktcode=b.mktcode AND e.tgtcode=b.tgtcode AND e.bizdate=b.bizdate\n  WHERE b.bizdate <= ?\n),\nfeatures AS (\n  SELECT history.*,\n    `v1` AS `f1`\n  FROM history\n),\ncurrent_rows AS (\n  SELECT * FROM features WHERE bizdate = ?\n),\nprefiltered AS (\n  SELECT * FROM current_rows WHERE (`f1` > ?)\n),\nrank_input AS (\n  SELECT * FROM prefiltered WHERE `v2` IS NOT NULL\n),\nranked AS (\n  SELECT rank_input.*,\n    ROW_NUMBER() OVER (ORDER BY `v2` DESC,mktcode,tgtcode) AS `r1`\n  FROM rank_input\n)\nSELECT mktcode,tgtcode\nFROM ranked\nWHERE (`r1` <= ?)\nORDER BY `r1`,mktcode,tgtcode\nLIMIT 7;",
    "bindings": [
      "2026-04-14",
      "2026-04-14",
      0,
      10
    ],
    "ordered": true,
    "coveragePlan": {
      "sql": "WITH history AS (\n  SELECT b.mktcode AS mktcode,b.tgtcode AS tgtcode,b.bizdate AS bizdate,\n    NULLIF(e.ZJLXMainNetTur,-999999) AS `v1`,\n    b.closePrice AS `v2`\n  FROM newzl.v_hsj_stock_hq_basic b\n  LEFT JOIN newzl.v_hsj_stock_hq_ext e ON e.mktcode=b.mktcode AND e.tgtcode=b.tgtcode AND e.bizdate=b.bizdate\n  WHERE b.bizdate <= ?\n),\nfeatures AS (\n  SELECT history.*,\n    `v1` AS `f1`\n  FROM history\n),\ncurrent_rows AS (\n  SELECT * FROM features WHERE bizdate = ?\n)\nSELECT COUNT(*),COALESCE(SUM(CASE WHEN cx.tgtcode IS NULL THEN 1 ELSE 0 END),0),COALESCE(SUM(CASE WHEN cov.`f1` IS NULL THEN 1 ELSE 0 END),0),COALESCE(SUM(CASE WHEN cov.`v2` IS NULL THEN 1 ELSE 0 END),0) FROM current_rows cov LEFT JOIN newzl.v_hsj_stock_hq_ext cx ON cx.mktcode=cov.mktcode AND cx.tgtcode=cov.tgtcode AND cx.bizdate=?;",
      "samplesSql": "WITH history AS (\n  SELECT b.mktcode AS mktcode,b.tgtcode AS tgtcode,b.bizdate AS bizdate,\n    NULLIF(e.ZJLXMainNetTur,-999999) AS `v1`,\n    b.closePrice AS `v2`\n  FROM newzl.v_hsj_stock_hq_basic b\n  LEFT JOIN newzl.v_hsj_stock_hq_ext e ON e.mktcode=b.mktcode AND e.tgtcode=b.tgtcode AND e.bizdate=b.bizdate\n  WHERE b.bizdate <= ?\n),\nfeatures AS (\n  SELECT history.*,\n    `v1` AS `f1`\n  FROM history\n),\ncurrent_rows AS (\n  SELECT * FROM features WHERE bizdate = ?\n)\nSELECT cov.mktcode,cov.tgtcode,CASE WHEN cx.tgtcode IS NULL THEN 1 ELSE 0 END,CASE WHEN cov.`f1` IS NULL THEN 1 ELSE 0 END,CASE WHEN cov.`v2` IS NULL THEN 1 ELSE 0 END FROM current_rows cov LEFT JOIN newzl.v_hsj_stock_hq_ext cx ON cx.mktcode=cov.mktcode AND cx.tgtcode=cov.tgtcode AND cx.bizdate=? WHERE cov.`f1` IS NULL OR cov.`v2` IS NULL OR (CASE WHEN cx.tgtcode IS NULL THEN 1 ELSE 0 END)=1 ORDER BY cov.mktcode,cov.tgtcode LIMIT 20;",
