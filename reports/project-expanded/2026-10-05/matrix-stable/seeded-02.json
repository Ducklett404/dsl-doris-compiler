    "windowContracts": [],
    "sql": "WITH base AS (\n  SELECT b.mktcode AS mktcode, b.tgtcode AS tgtcode, b.bizdate AS bizdate,\n    b.volume AS `m1`,\n    NULLIF(e.ZJLXMainNetTur,-999999) AS `m2`,\n    b.openPrice AS `m3`\n  FROM newzl.v_hsj_stock_hq_basic b\n  LEFT JOIN newzl.v_hsj_stock_hq_ext e ON e.mktcode=b.mktcode AND e.tgtcode=b.tgtcode AND e.bizdate=b.bizdate\n  WHERE DATE_FORMAT(b.bizdate,'%Y-%m-%d') = ?\n    AND b.mktcode = 103\n)\nSELECT mktcode, tgtcode\nFROM base\nWHERE ((`m1` != ?) AND ((`m2` != (-?)) AND (`m3` <= ?)))\nORDER BY mktcode, tgtcode\nLIMIT 10000;",
    "bindings": [
      "2020-02-03",
      100000,
      1000000,
      1
    ],
    "ordered": false,
    "coveragePlan": {
      "sql": "WITH base AS (\n  SELECT b.mktcode AS mktcode, b.tgtcode AS tgtcode, b.bizdate AS bizdate,\n    b.volume AS `m1`,\n    NULLIF(e.ZJLXMainNetTur,-999999) AS `m2`,\n    b.openPrice AS `m3`\n  FROM newzl.v_hsj_stock_hq_basic b\n  LEFT JOIN newzl.v_hsj_stock_hq_ext e ON e.mktcode=b.mktcode AND e.tgtcode=b.tgtcode AND e.bizdate=b.bizdate\n  WHERE DATE_FORMAT(b.bizdate,'%Y-%m-%d') = ?\n    AND b.mktcode = 103\n)\nSELECT COUNT(*),COALESCE(SUM(CASE WHEN cx.tgtcode IS NULL THEN 1 ELSE 0 END),0),COALESCE(SUM(CASE WHEN cov.`m1` IS NULL THEN 1 ELSE 0 END),0),COALESCE(SUM(CASE WHEN cov.`m2` IS NULL THEN 1 ELSE 0 END),0),COALESCE(SUM(CASE WHEN cov.`m3` IS NULL THEN 1 ELSE 0 END),0) FROM base cov LEFT JOIN newzl.v_hsj_stock_hq_ext cx ON cx.mktcode=cov.mktcode AND cx.tgtcode=cov.tgtcode AND cx.bizdate=?;",
      "samplesSql": "WITH base AS (\n  SELECT b.mktcode AS mktcode, b.tgtcode AS tgtcode, b.bizdate AS bizdate,\n    b.volume AS `m1`,\n    NULLIF(e.ZJLXMainNetTur,-999999) AS `m2`,\n    b.openPrice AS `m3`\n  FROM newzl.v_hsj_stock_hq_basic b\n  LEFT JOIN newzl.v_hsj_stock_hq_ext e ON e.mktcode=b.mktcode AND e.tgtcode=b.tgtcode AND e.bizdate=b.bizdate\n  WHERE DATE_FORMAT(b.bizdate,'%Y-%m-%d') = ?\n    AND b.mktcode = 103\n)\nSELECT cov.mktcode,cov.tgtcode,CASE WHEN cx.tgtcode IS NULL THEN 1 ELSE 0 END,CASE WHEN cov.`m1` IS NULL THEN 1 ELSE 0 END,CASE WHEN cov.`m2` IS NULL THEN 1 ELSE 0 END,CASE WHEN cov.`m3` IS NULL THEN 1 ELSE 0 END FROM base cov LEFT JOIN newzl.v_hsj_stock_hq_ext cx ON cx.mktcode=cov.mktcode AND cx.tgtcode=cov.tgtcode AND cx.bizdate=? WHERE cov.`m1` IS NULL OR cov.`m2` IS NULL OR cov.`m3` IS NULL OR (CASE WHEN cx.tgtcode IS NULL THEN 1 ELSE 0 END)=1 ORDER BY cov.mktcode,cov.tgtcode LIMIT 20;",
