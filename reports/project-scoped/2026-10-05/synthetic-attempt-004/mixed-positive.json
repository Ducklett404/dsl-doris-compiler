    ],
    "ordered": false,
    "coveragePlan": {
      "sql": "WITH base AS (\n  SELECT b.mktcode AS mktcode, b.tgtcode AS tgtcode, b.bizdate AS bizdate,\n    b.closePrice AS `m1`,\n    NULLIF(e.ZJLXMainNetTur,-999999) AS `m2`\n  FROM dsl_project_fixture_a126970fb3fb.v_hsj_stock_hq_basic b\n  LEFT JOIN dsl_project_fixture_a126970fb3fb.v_hsj_stock_hq_ext e ON e.mktcode=b.mktcode AND e.tgtcode=b.tgtcode AND e.bizdate=b.bizdate\n  WHERE DATE_FORMAT(b.bizdate,'%Y-%m-%d') = ?\n)\nSELECT COUNT(*),COALESCE(SUM(CASE WHEN cx.tgtcode IS NULL THEN 1 ELSE 0 END),0),COALESCE(SUM(CASE WHEN cov.`m1` IS NULL THEN 1 ELSE 0 END),0),COALESCE(SUM(CASE WHEN cov.`m2` IS NULL THEN 1 ELSE 0 END),0) FROM base cov LEFT JOIN dsl_project_fixture_a126970fb3fb.v_hsj_stock_hq_ext cx ON cx.mktcode=cov.mktcode AND cx.tgtcode=cov.tgtcode AND cx.bizdate=?;",
