    "sql": "WITH history AS (\n  SELECT b.mktcode AS mktcode,b.tgtcode AS tgtcode,b.bizdate AS bizdate,c.name AS name,c.hyBlkRefName AS hyBlkRefName,\n    b.closePrice AS `v1`\n  FROM dsl_project_fixture_1c8897fdd68a.v_hsj_stock_hq_basic b\n  LEFT JOIN dsl_project_fixture_1c8897fdd68a.hsj_stock_code_info c ON c.mktcode=b.mktcode AND c.tgtcode=b.tgtcode\n  WHERE b.bizdate <= ?\n),\nfeatures AS (\n  SELECT history.*,\n    `v1` AS `f1`,\n    MAX(CASE WHEN tgtcode=? OR name=? THEN `v1` END) OVER (PARTITION BY bizdate) AS `f2`\n  FROM history\n),\ncurrent_rows AS (\n  SELECT * FROM features WHERE bizdate = ?\n)\nSELECT mktcode,tgtcode\nFROM current_rows\nWHERE (`f1` > `f2`)\nORDER BY mktcode,tgtcode;",
