    "sql" : "WITH history AS (\n  SELECT pf.mktcode AS mktcode,pf.tgtcode AS tgtcode,pf.bizdate AS bizdate,\n    pf.ma60 AS `v1`\n  FROM newzl.stock_daily_features_v1 pf\n  WHERE pf.bizdate = ?\n    AND pf.mktcode=1\n),\nfeatures AS (\n  SELECT history.*,\n    `v1` AS `f1`\n  FROM history\n),\ncurrent_rows AS (\n  SELECT * FROM features WHERE bizdate = ?\n)\nSELECT mktcode,tgtcode\nFROM current_rows\nWHERE (`f1` > ?)\nORDER BY mktcode,tgtcode\nLIMIT 100;",
