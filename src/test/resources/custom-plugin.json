{
  "functions": [
    {
      "name":"ABS_CHANGE",
      "id":"custom.abs_change",
      "version":"1.0.0",
      "signature":{
        "arguments":[
          {"name":"left","type":"PRICE"},
          {"name":"right","type":"PRICE"}
        ],
        "returnType":"NUMBER"
      },
      "minArgs":2,
      "maxArgs":2,
      "returnType":"NUMBER",
      "requiredFields":[],
      "adjustmentRequirement":"ANY",
      "nullPolicy":"ALLOW_PARTIAL_WINDOW",
      "loweringKind":"TEMPLATE",
      "sqlTemplate":"ABS({0} - {1})",
      "capabilities":{"minDorisVersion":"2.1","requiredFunctions":["ABS"]},
      "tests":[
        {"dsl":"SCREEN ON 2026-08-07 WHERE ABS_CHANGE(CLOSE, OPEN) > 1 LIMIT 10","expectedSqlContains":"ABS(`close` - `open`) > ?"}
      ]
    },
    {
      "name":"VOLATILITY",
      "id":"custom.volatility",
      "version":"1.0.0",
      "signature":{
        "arguments":[
          {"name":"value","type":"PRICE"},
          {"name":"window","type":"NUMBER"}
        ],
        "returnType":"NUMBER"
      },
      "returnType":"NUMBER",
      "requiredFields":[],
      "windowSpec":{
        "lengthArg":1,
        "unit":"TRADING_DAY",
        "partitionKeys":["symbol"],
        "orderKeys":["trade_date"],
        "nullPolicy":"STRICT_FULL_WINDOW",
        "requireFullWindow":true
      },
      "adjustmentRequirement":"ANY",
      "nullPolicy":"STRICT_FULL_WINDOW",
      "loweringKind":"WINDOW_STDDEV",
      "irBuilder":"WindowStddevBuilder",
      "lookbackArg":1,
      "capabilities":{"minDorisVersion":"2.1","requiredFunctions":["STDDEV_SAMP"]},
      "tests":[
        {"dsl":"SCREEN ON 2026-08-07 WHERE VOLATILITY(CLOSE, 20) > 1 LIMIT 10","expectedSqlContains":"STDDEV_SAMP(`close`) OVER"}
      ]
    }
  ]
}
